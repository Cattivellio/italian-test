# --- Italian Test (PLIDA B1 Leggere) config ------------------------------

# Google AI (Gemini) API key used by the AI exercise generator.
# Leave empty to disable the generate feature (exercises still work offline).
GEMINI_API_KEY=

# Gemini model used for generation. Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Admin bootstrap -----------------------------------------------------
# The first time the app starts, if no admin user exists, an administrator
# account is created from these values. Set a strong password — do NOT leave
# this empty in production (no admin account will be created if it is).
ADMIN_PHONE=+584126778168
ADMIN_PASSWORD=
ADMIN_NAME=Amministratore

# --- Cookies / sessions --------------------------------------------------
# Set to true only if the app is served over HTTPS (recommended behind TLS).
SESSION_COOKIE_SECURE=false

# Server bind address / port. Use 0.0.0.0 to allow access from other devices
# on the network (e.g. your phone via the LAN IP).
ITALIAN_TEST_HOST=0.0.0.0
ITALIAN_TEST_PORT=8050

# Database file path (SQLite).
ITALIAN_TEST_DB=data/italian_test.db
